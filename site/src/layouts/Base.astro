---
import config from '../../site.config.json';
const { title, description, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
{jsonld.map(obj => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
<style is:global>
:root{--bg:#fff;--fg:#1a2233;--muted:#5a6478;--line:#e3e7ef;--acc:#0b57d0;--accbg:#eef3fe;--good:#0a7a3d;--warn:#8a5a00;--card:#f7f9fc}
@media(prefers-color-scheme:dark){:root{--bg:#10141d;--fg:#e8ecf4;--muted:#9aa4b8;--line:#2a3345;--acc:#8ab4f8;--accbg:#1c2941;--good:#7dd8a2;--warn:#e5c07b;--card:#181e2b}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
a{color:var(--acc);text-decoration:none}a:hover{text-decoration:underline}
header{border-bottom:1px solid var(--line)}
.wrap{max-width:960px;margin:0 auto;padding:0 16px}
header .wrap{display:flex;align-items:baseline;gap:12px;padding-top:14px;padding-bottom:14px;flex-wrap:wrap}
.brand{font-weight:700;font-size:1.15rem;color:var(--fg)}
.tag{color:var(--muted);font-size:.85rem}
main{padding:20px 0 40px}
h1{font-size:1.5rem;line-height:1.25;margin:.4em 0}
h2{font-size:1.15rem;margin:1.6em 0 .5em}
.big{font-size:2.2rem;font-weight:700;margin:.2em 0}
.badge{display:inline-block;background:var(--accbg);color:var(--acc);border-radius:6px;padding:2px 10px;font-size:.85rem;font-weight:600}
.fresh{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 16px;margin:16px 0;font-size:.92rem}
.fresh b{color:var(--good)}
table{border-collapse:collapse;width:100%;font-size:.95rem}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:600;font-size:.85rem}
tr:hover td{background:var(--card)}
.num{font-variant-numeric:tabular-nums;white-space:nowrap}
.muted{color:var(--muted)}.small{font-size:.85rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;padding:0;list-style:none}
.grid li{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--card)}
.grid a{font-weight:600}
.crumbs{font-size:.85rem;color:var(--muted);margin:10px 0 0}
.prov{border-left:3px solid var(--acc);padding:8px 14px;margin:18px 0;font-size:.9rem;color:var(--muted);background:var(--card);border-radius:0 8px 8px 0}
footer{border-top:1px solid var(--line);color:var(--muted);font-size:.85rem;padding:18px 0 30px}
footer .wrap{display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between}
.tablewrap{overflow-x:auto}
@media(max-width:600px){h1{font-size:1.25rem}.big{font-size:1.8rem}}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <a class="brand" href="/">{config.SITE_NAME}</a>
    <span class="tag">{config.TAGLINE}</span>
    <nav class="small" style="margin-left:auto"><a href="/canada/">Canada</a> · <a href="/uk/">UK</a> · <a href="/about/">Methodology</a> · <a href="/api-docs/">API</a></nav>
  </div>
</header>
<main><div class="wrap"><slot /></div></main>
<footer>
  <div class="wrap">
    <span>© 2026 {config.SITE_NAME}. Values are official figures published by the named government agencies; we track and republish them with full provenance. Not legal advice.</span>
    <span><a href="/about/">How this data is collected</a> · <a href="/api-docs/">JSON API</a> · <a href="/llms.txt">llms.txt</a></span>
  </div>
</footer>
</body>
</html>
