---
import Base from '../../layouts/Base.astro';
import EditorialByline from '../../components/EditorialByline.astro';
import { dataLastmod, stats, fmtDate } from '../../lib/data.js';
import { reportIssues } from '../../lib/reports.js';

const latestIssue = reportIssues[0];
const checked = [dataLastmod, ...reportIssues.map(issue => issue.published)].sort().at(-1);
---
<Base title="Government processing-time change reports — GovWait" description="Permanent, source-backed change reports for Canadian, UK, New Zealand and Norway visa and government processing times, with every value tied to official history.">
  <nav class="crumbs"><a href="/">Home</a> › Reports</nav>
  <h1>Processing-time reports</h1>
  <p class="lede">Original analysis from GovWait’s append-only dataset: what each government publishes now, where the widest gaps sit, and what changes after a second observation exists.</p>
  <EditorialByline published="2026-08-23" checked={checked} label="Latest report update" />

  {latestIssue ? (
    <div class="callout good"><span class="report-status">Change reporting is live</span><p>The latest permanent issue found <strong>{latestIssue.changes.length} numeric changes</strong> in {latestIssue.jur.shortAgency}’s published values dated {fmtDate(latestIssue.date)}. <a href={latestIssue.path}>Read the complete dated report</a> or <a href="/reports/feed.xml">subscribe by RSS</a>. A submission receipt or crawl does not prove search indexing.</p></div>
  ) : (
    <div class="callout good"><span class="report-status">Baseline release</span><p>No later comparable official observation exists yet. These reports preserve the baseline without inventing movement and will create a permanent issue after a verified value changes.</p></div>
  )}

  <ul class="grid">
    <li><a class="t" href="/reports/canada-processing-time-changes/">Canada processing-time changes &amp; comparison</a><p class="small muted">Current country coverage, medians, ranges and verified IRCC movements by service.</p></li>
    <li><a class="t" href="/reports/uk-visa-processing-time-changes/">UK visa-standard baseline &amp; changes</a><p class="small muted">Inside-versus-outside comparisons and the current UKVI standard distribution.</p></li>
    <li><a class="t" href="/reports/new-zealand-visa-processing-time-changes/">New Zealand visa baseline &amp; changes</a><p class="small muted">The gap between INZ’s 50% and 80% completion points across reviewed visas.</p></li>
    <li><a class="t" href="/reports/norway-processing-time-changes/">Norway UDI baseline &amp; changes</a><p class="small muted">Nineteen table-backed routes, their current planning spectrum and verified monthly movement when it appears.</p></li>
  </ul>

  {reportIssues.length > 0 && <>
    <h2>Permanent dated issues</h2>
    <p>Each issue keeps the old and new official values at a stable URL. Later refreshes add another issue rather than replacing earlier analysis.</p>
    <ul class="grid">
      {reportIssues.map(issue => (
        <li><a class="t" href={issue.path}>{issue.jur.shortName} changes — {fmtDate(issue.date)}</a><p class="small muted">{issue.changes.length} changed values: {issue.longer.length} longer and {issue.shorter.length} shorter; {issue.unchanged.length} comparable values stayed the same.</p></li>
      ))}
    </ul>
  </>}

  <h2>How to cite a report</h2>
  <p>Link the permanent report URL, name the government agency, and include the data date shown on the report. The report should not be described as a promise about an individual application.</p>
  <p class="small muted">Dataset generated {fmtDate(stats.generated_at)} · {stats.entities.toLocaleString()} routes · {stats.observations.toLocaleString()} observations · <a href="/reports/feed.xml">RSS feed</a>.</p>
</Base>
