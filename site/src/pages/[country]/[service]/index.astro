---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Freshness from '../../../components/Freshness.astro';
import ForwardLookingPanel from '../../../components/ForwardLookingPanel.astro';
import { services, JURISDICTIONS, fmtDate, fmtMonthYear, fmtMonthYearShort, humanValue } from '../../../lib/data.js';

export function getStaticPaths() {
  const paths = [];
  for (const [code, jur] of Object.entries(JURISDICTIONS)) {
    for (const svc of services[code].values()) {
      if (!svc.published) continue;
      paths.push({ params: { country: jur.slug, service: svc.slug }, props: { code, slug: svc.slug } });
    }
  }
  return paths;
}
const { code, slug } = Astro.props;
const jur = JURISDICTIONS[code];
const svc = services[code].get(slug);
const single = !svc.hasApplicantPages;
const percentile = svc.isPercentileService;
const rec = percentile ? svc.percent80 : svc.records[0];
const forward = rec.metric_type === 'forward';
const norway = rec.jurisdiction === 'NO';
const publishedRange = norway && /\d\s*[–—-]\s*\d/.test(rec.value_raw);
const ok = svc.records.filter(r => r.status === 'ok');

const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: jur.name, item: new URL(`/${jur.slug}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: svc.name, item: new URL(`/${jur.slug}/${svc.slug}/`, Astro.site).href },
  ],
};
const govService = {
  '@context': 'https://schema.org', '@type': 'GovernmentService',
  name: `${svc.name} — ${jur.name}`,
  serviceOperator: { '@type': 'GovernmentOrganization', name: jur.agency },
  areaServed: jur.name,
  url: new URL(`/${jur.slug}/${svc.slug}/`, Astro.site).href,
};

const topic = /\bprocessing(?: time)?\b/i.test(svc.seoName) ? svc.seoName : `${svc.seoName} processing time`;
const sameNameAndScope = [...services[code].values()]
  .filter(s => s.name === svc.name && s.scope === svc.scope);
const scopeDetail = svc.scope
  ? `${svc.scope}${sameNameAndScope.length > 1 && svc.section ? ` — ${svc.section.toLowerCase()}` : ''}`
  : null;
const monthTok = fmtMonthYear(rec.effective_date);
const monthShort = fmtMonthYearShort(rec.effective_date);
const forwardTitleNames = {
  'ca-atlantic-immigration-program': 'Canada Atlantic immigration wait',
  'ca-canadian-experience-class': 'Canada CEC processing time',
  'ca-federal-skilled-worker': 'Canada FSW processing time',
  'ca-provincial-nominee-non-express-entry': 'Canada PNP non-Express Entry wait',
  'ca-provincial-nominee-express-entry': 'Canada PNP Express Entry wait',
  'ca-quebec-skilled-worker': 'Quebec skilled worker processing time',
  'ca-parents-grandparents-sponsorship-quebec': 'Canada PGP Quebec wait',
  'ca-parents-grandparents-sponsorship-outside-quebec': 'Canada PGP outside-Quebec wait',
  'ca-spouse-partner-inside-canada-quebec': 'In-Canada spouse Quebec wait',
  'ca-spouse-partner-inside-canada-outside-quebec': 'In-Canada spouse outside-Quebec wait',
  'ca-spouse-partner-outside-canada-quebec': 'Overseas spouse Quebec wait',
  'ca-spouse-partner-outside-canada-outside-quebec': 'Overseas spouse outside-Quebec wait',
};
const forwardTitleName = forwardTitleNames[rec.service_key] || `${jur.shortName} ${svc.seoName} wait`;
const title = forward
  ? `${forwardTitleName}: projected ${humanValue(rec)}`
  : percentile
  ? `NZ ${svc.seoName} processing time: 50% ${svc.percent50.value_raw}, 80% ${svc.percent80.value_raw}`
  : single
  ? norway
    ? `${jur.shortName} ${topic}: ${humanValue(rec)}`
    : `${jur.shortName} ${topic}${scopeDetail ? ` (${scopeDetail})` : ''}: ${humanValue(rec)} (${monthShort})`
  : `${jur.shortName} ${topic} by country (${monthShort})`;
const desc = forward
  ? `IRCC's ${forwardTitleName.toLowerCase()} is projected at ${humanValue(rec)}. See the current queue and application-month estimates, updated ${monthShort}.`
  : percentile
  ? `INZ currently reports 50% of ${svc.name} applications processed within ${svc.percent50.value_raw} and 80% within ${svc.percent80.value_raw}. Official source and history.`
  : single
  ? `${jur.shortAgency} reports ${humanValue(rec)} for ${svc.seoName}${scopeDetail ? ` (${scopeDetail})` : ''}. Updated ${monthTok}, with official-source history.`
  : `Current ${jur.shortAgency} ${topic.toLowerCase()} for ${svc.records.length} applicant countries: ${ok.length} published values. Updated ${monthShort}, with official sources and history.`;
---
<Base title={title} description={desc} jsonld={[crumbs, govService]}>
  <nav class="crumbs"><a href="/">Home</a> › <a href={`/${jur.slug}/`}>{jur.name}</a> › {svc.name}</nav>
  <h1>{forward
    ? `${svc.name}: current projected processing time`
    : percentile
    ? `${svc.name} processing time: current New Zealand figures`
    : single ? `${svc.name} (${jur.name}): current processing time` : `${jur.name} ${svc.name}: processing time by applicant country`}</h1>

  {forward ? (
    <ForwardLookingPanel record={rec} service={svc} jurisdiction={jur} />
  ) : percentile ? (
    <>
      <div class="stats">
        <div><div class="n">{humanValue(svc.percent50)}</div><div class="l">50% of applications processed</div></div>
        <div><div class="n">{humanValue(svc.percent80)}</div><div class="l">80% of applications processed</div></div>
      </div>
      <Freshness record={svc.percent80} />
      <AdSlot position="service-top" />
      <p>Immigration New Zealand currently reports that 50% of <strong>{svc.name}</strong> applications are processed within <strong>{humanValue(svc.percent50)}</strong>, and 80% within <strong>{humanValue(svc.percent80)}</strong>. These are working days, excluding Saturdays, Sundays and New Zealand public holidays.</p>
      <p>The figures are a guide based on current processing timeframes, not a deadline or promise for an individual application. Missing information, application complexity and peak demand can make a case take longer.</p>
      <h2>History we have recorded</h2>
      <div class="tablewrap"><table>
        <thead><tr><th>Official measure</th><th>Official value</th><th>First observed</th><th>Verified on that observation</th></tr></thead>
        <tbody>{[
          ...svc.percent50.history.map(h => ({ ...h, metric: '50% processed' })),
          ...svc.percent80.history.map(h => ({ ...h, metric: '80% processed' })),
        ].sort((a, b) => b.effective_date.localeCompare(a.effective_date) || a.metric.localeCompare(b.metric)).map(h => (
          <tr><td>{h.metric}</td><td>{h.value_raw}</td><td class="num">{fmtDate(h.effective_date)}</td><td class="num">{fmtDate(h.retrieved_at)}</td></tr>
        ))}</tbody>
      </table></div>
      <p class="small muted">INZ does not provide a source update date for this tool. We therefore date a value when GovWait first observes it and add a new history row only when the official value changes.</p>
      <p class="small"><a href="/guides/how-new-zealand-visa-processing-times-work/">How to read New Zealand’s 50% and 80% processing-time figures →</a></p>
    </>
  ) : single ? (
    <>
      <div class="value-hero"><span class={`v ${rec.status === 'ok' ? '' : 'na'}`}>{humanValue(rec)}</span></div>
      <Freshness record={rec} />
      <AdSlot position="service-top" />
      <p>This is the current figure {jur.agency} publishes for <strong>{rec.service_name}</strong>. It reflects {svc.blurb}. The figure is a published statistic or service standard, not a guarantee for any individual application.</p>
      {norway && <>
        <h2>How to read this UDI waiting time</h2>
        <p>UDI describes its waiting times as guides that can change while an application is being processed. The official source page explains which authority handles this route and when its clock begins. GovWait preserves UDI’s exact wording and update date; it does not infer a personal case status or completion date.</p>
        {publishedRange && <p class="small muted">UDI publishes this route as a range. The API keeps <strong>{rec.value_raw}</strong> verbatim and uses the upper end only in the normalized <code>value_days</code> comparison field, as a conservative planning bound.</p>}
        <p class="small"><a href="/guides/how-norway-udi-waiting-times-work/">How Norway’s UDI waiting-time tables work →</a></p>
      </>}
      <h2>History we have recorded</h2>
      <div class="tablewrap"><table>
        <thead><tr><th>Official value</th><th>{rec.unstamped ? 'First observed' : 'Published/updated'}</th><th>Verified on that observation</th></tr></thead>
        <tbody>{rec.history.slice().reverse().map(h => (
          <tr><td>{h.value_raw}</td><td class="num">{fmtDate(h.effective_date)}</td><td class="num">{fmtDate(h.retrieved_at)}</td></tr>
        ))}</tbody>
      </table></div>
      <p class="small muted">Tracking began August 2026. History grows automatically with each official update.{rec.unstamped ? ' This source has no update stamp, so unchanged checks do not create duplicate history rows.' : ''}</p>
    </>
  ) : (
    <>
      <p class="lede">{jur.agency} publishes {svc.blurb}, per applicant country, and refreshes the figures roughly weekly. <strong>{ok.length}</strong> of {svc.records.length} countries currently have a published time{svc.medianDays ? `; the median is ${Math.round(svc.medianDays)} days` : ''}. Countries without a published figure are listed too — that absence is itself official information.</p>
      <Freshness record={rec} />
      <AdSlot position="service-top" />
      <div class="tablewrap"><table>
        <thead><tr><th>Applying from</th><th>Official processing time</th><th>vs. typical</th></tr></thead>
        <tbody>
          {svc.records.map(r => (
            <tr>
              <td><a href={`/${jur.slug}/${svc.slug}/${r.applicantSlug}/`}>{r.applicant_country_name}</a></td>
              <td class="num">{humanValue(r)}</td>
              <td>{r.speed ? <span class={`chip ${r.speed.cls}`}>{r.speed.label}</span> : <span class="chip na">—</span>}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </>
  )}

  <div class="prov">Source: <a href={rec.source_url} rel="noopener nofollow">{jur.agency}</a> · extracted values only, republished with attribution · not legal advice.</div>
  <AdSlot position="service-bottom" />
</Base>
