---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Freshness from '../../../components/Freshness.astro';
import { records, services, relatedRoutes, JURISDICTIONS, fmtDate, fmtMonthYear, humanValue } from '../../../lib/data.js';

export function getStaticPaths() {
  return records.filter(r => r.applicantSlug).map(r => ({
    params: { country: r.jur.slug, service: r.serviceSlug, applicant: r.applicantSlug },
    props: { id: r.id },
  }));
}
const { id } = Astro.props;
const rec = records.find(r => r.id === id);
const jur = rec.jur;
const svc = services[rec.jurisdiction].get(rec.serviceSlug);
const siblings = svc.records.filter(r => r.status === 'ok' && r.id !== rec.id);
const rank = rec.status === 'ok' ? siblings.filter(s => s.value_days < rec.value_days).length + 1 : null;
const related = relatedRoutes(rec);

const pageUrl = new URL(`/${jur.slug}/${rec.serviceSlug}/${rec.applicantSlug}/`, Astro.site).href;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: jur.name, item: new URL(`/${jur.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: svc.name, item: new URL(`/${jur.slug}/${rec.serviceSlug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 4, name: `From ${rec.applicant_country_name}`, item: pageUrl },
    ] },
  { '@context': 'https://schema.org', '@type': 'GovernmentService',
    name: `${svc.name} for applicants from ${rec.applicant_country_name} — ${jur.name}`,
    serviceOperator: { '@type': 'GovernmentOrganization', name: jur.agency },
    areaServed: jur.name, audience: { '@type': 'Audience', name: `Applicants from ${rec.applicant_country_name}` },
    url: pageUrl },
];
const monthTok = fmtMonthYear(rec.effective_date);
const svcTitle = svc.name.replace(/\b[a-z]/g, c => c.toUpperCase());
const title = rec.status === 'ok'
  ? `${jur.name} ${svcTitle} Processing Time from ${rec.applicant_country_name} — ${monthTok}: ${rec.value_raw} (Official)`
  : `${jur.name} ${svcTitle} Processing Time from ${rec.applicant_country_name} — ${monthTok}: No Published Time (Official)`;
const deltaText = rec.delta
  ? (rec.delta.dir === 'flat'
      ? `Unchanged from the previous official update (${fmtDate(rec.delta.prev_date)}).`
      : `${rec.delta.dir === 'up' ? '▲ Up' : '▼ Down'} ${rec.delta.pct}% from ${rec.delta.prev_raw} (${fmtDate(rec.delta.prev_date)}).`)
  : null;
---
<Base title={title}
      description={`Official ${jur.name} processing time for ${svc.name.toLowerCase()} applications from ${rec.applicant_country_name}: ${humanValue(rec)}. Published by ${jur.agency}, tracked with provenance and history.`}
      jsonld={jsonld}>
  <nav class="crumbs"><a href="/">Home</a> › <a href={`/${jur.slug}/`}>{jur.name}</a> › <a href={`/${jur.slug}/${rec.serviceSlug}/`}>{svc.name}</a> › {rec.applicant_country_name}</nav>
  <h1>{svc.name} ({jur.name}) — applying from {rec.applicant_country_name}</h1>

  <div class="value-hero">
    <span class={`v ${rec.status === 'ok' ? '' : 'na'}`}>{humanValue(rec)}</span>
    {rec.speed && <span class={`chip ${rec.speed.cls}`}>{rec.speed.label}</span>}
    {rec.status === 'ok' && rank && <span class="chip acc num">#{rank} of {siblings.length + 1} countries</span>}
  </div>
  {deltaText && <p class="small" style="margin-top:-2px"><strong>{deltaText}</strong></p>}
  <Freshness record={rec} />
  <AdSlot position="entity-top" />

  <h2>How long does a {jur.name} {svc.name.toLowerCase()} take from {rec.applicant_country_name} right now?</h2>
  <p>
    {rec.status === 'ok'
      ? `${jur.agency} currently reports ${rec.value_raw} to process ${svc.name.toLowerCase()} applications from ${rec.applicant_country_name}${svc.medianDays ? `, against a median of ${Math.round(svc.medianDays)} days across all countries with published figures` : ''}. The agency recalculates this figure from recent completed cases, so it moves — we re-check it weekly and keep every published value below.`
      : rec.status === 'unavailable'
        ? `${jur.agency} does not currently publish a processing time for ${svc.name.toLowerCase()} applications from ${rec.applicant_country_name}. That usually means too few recent applications from this country to compute a reliable figure. We check weekly and will record a value the moment one is published.`
        : `${jur.agency} currently marks this route as having too little data to publish a reliable processing time. We check weekly and will record a value the moment one is published.`}
  </p>
  {rec.jurisdiction === 'CA' && <p class="small muted">IRCC notes its published figures show "how long it took us to process most complete applications in the past" — a backward-looking statistic covering roughly 80% of recently finalized cases, not a guarantee for new applications.</p>}

  <h2>Recorded history</h2>
  <div class="tablewrap"><table>
    <thead><tr><th>Official value</th><th>Published/updated</th><th>Verified by us</th></tr></thead>
    <tbody>{rec.history.slice().reverse().map(h => (
      <tr><td>{h.status === 'ok' ? h.value_raw : humanValue(h)}</td><td class="num">{fmtDate(h.effective_date)}</td><td class="num">{fmtDate(h.retrieved_at)}</td></tr>
    ))}</tbody>
  </table></div>
  <p class="small muted">Tracking began August 2026; a new row appears whenever the official figure changes.</p>

  <h2>Compare</h2>
  <p class="small">See <a href={`/${jur.slug}/${rec.serviceSlug}/`}>all {svc.records.length} applicant countries for {svc.name.toLowerCase()}</a>{siblings.length ? `, currently ranging from ${siblings[0].value_raw} (${siblings[0].applicant_country_name}) to ${siblings.at(-1).value_raw} (${siblings.at(-1).applicant_country_name})` : ''}.</p>

  {related.length > 0 && (
    <>
      <h2>Other {jur.name} routes from {rec.applicant_country_name}</h2>
      <div class="related">
        {related.map(r => (
          <a href={`/${jur.slug}/${r.serviceSlug}/${r.applicantSlug}/`}>{services[r.jurisdiction].get(r.serviceSlug).name}: <strong class="num">&nbsp;{r.status === 'ok' ? r.value_raw : 'n/a'}</strong></a>
        ))}
      </div>
    </>
  )}

  <h2>Common questions</h2>
  <h3>{rec.status === 'ok' ? `Is ${rec.value_raw} a guarantee?` : 'Can you still apply without a published time?'}</h3>
  <p class="small">{rec.status === 'ok'
    ? `No — it is the agency's own statistic about recently completed applications. Individual cases vary with documentation completeness, verification checks, and application volume. Always confirm against the linked official source before making travel or financial decisions.`
    : `Yes — the absence of a figure reflects the agency's reporting thresholds, not your eligibility. Check the linked official source for the current guidance.`}</p>
  {rec.jurisdiction === 'CA' && (
    <>
      <h3>Does the published time include biometrics? What about "after biometrics"?</h3>
      <p class="small">IRCC's published clock runs from receipt of a complete application to the final decision, and IRCC states it includes the time taken to provide biometrics. Stage-by-stage clocks ("after biometrics", "after medical") are not published officially — breakdowns you see on forums are applicant anecdotes, not data. We track only what the agency publishes.</p>
    </>
  )}
  <h3>Why might an application take longer than the published time?</h3>
  <p class="small">{
    svc.category === 'refugee' || rec.service_category === 'refugee'
      ? 'Resettlement timelines depend on referral pathways, interview scheduling abroad, and security and medical checks — each adds variance the headline figure averages away. The published number covers most, not all, recently finalized cases.'
      : rec.service_category === 'sponsorship'
        ? 'Sponsorship files involve two assessments — the sponsor and the applicant — so an issue with either side extends the clock. Requests for additional documents pause processing and are the most common cause of overruns.'
        : `The published figure covers most recently finalized cases, not all of them. Incomplete documents, biometrics delays, medical or security verification, and volume surges from ${rec.applicant_country_name} can each push an individual file past the posted time.`
  }</p>

  <div class="prov">Source: <a href={rec.source_url} rel="noopener nofollow">{jur.agency}</a> · value retrieved {fmtDate(rec.retrieved_at)} · extracted values only · not legal advice.</div>
  <AdSlot position="entity-bottom" />
</Base>
