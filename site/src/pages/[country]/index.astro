---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { services, JURISDICTIONS, fmtDate } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.entries(JURISDICTIONS).map(([code, jur]) => ({ params: { country: jur.slug }, props: { code } }));
}
const { code } = Astro.props;
const jur = JURISDICTIONS[code];
const svcs = [...services[code].values()];
const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: jur.name, item: new URL(`/${jur.slug}/`, Astro.site).href },
  ],
}];
---
<Base title={`${jur.name} processing times — every officially published figure, tracked`}
      description={`Current official processing times published by ${jur.agency}: ${svcs.map(s=>s.name).slice(0,4).join(', ')} and more. Sourced and dated.`}
      jsonld={jsonld}>
  <nav class="crumbs"><a href="/">Home</a> › {jur.name}</nav>
  <h1>{jur.name}: official processing times</h1>
  <p>All figures below are published by {jur.agency} and re-checked by us on a weekly schedule. Click a service for the full breakdown{svcs.some(s=>s.hasApplicantPages) ? ' by applicant country' : ''}.</p>
  <AdSlot position="hub-top" />
  <div class="tablewrap"><table>
    <thead><tr><th>Service</th><th>Coverage</th><th>Official value</th><th>Last updated</th></tr></thead>
    <tbody>
      {svcs.map(svc => (
        <tr>
          <td><a href={`/${jur.slug}/${svc.slug}/`}>{svc.name}</a></td>
          <td class="small muted">{svc.hasApplicantPages ? `${svc.records.length} countries (${svc.okCount} with published times)` : 'service standard'}</td>
          <td class="num">{svc.hasApplicantPages ? `${svc.records.find(r=>r.status==='ok')?.value_raw ?? '—'} (fastest)` : svc.records[0].value_raw}</td>
          <td class="num">{fmtDate(svc.latestEffective)}</td>
        </tr>
      ))}
    </tbody>
  </table></div>
  <AdSlot position="hub-bottom" />
</Base>
