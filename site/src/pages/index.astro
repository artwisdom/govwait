---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import config from '../../site.config.json';
import { stats, services, records, JURISDICTIONS, publishedServices, fmtDate, dataLastmod } from '../lib/data.js';

const origin = config.SITE_URL.replace(/\/$/, '');
const orgId = `${origin}/#organization`;
const siteId = `${origin}/#website`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': siteId,
    url: origin,
    name: config.SITE_NAME,
    description: config.TAGLINE,
    publisher: { '@id': orgId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: config.SITE_NAME,
    url: origin,
    email: 'contact@govwait.com',
    logo: { '@type': 'ImageObject', url: `${origin}/favicon.svg` },
    publishingPrinciples: `${origin}/about/editorial-policy/`,
    sameAs: ['https://github.com/artwisdom/govwait'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `${config.SITE_NAME}: official government processing times`,
    description: 'Tracked dataset of officially published government processing and wait times for visas, permits, sponsorships and resettlement, with per-value provenance and history.',
    url: origin,
    datePublished: '2026-08-21',
    dateModified: dataLastmod,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    creator: { '@id': orgId },
    temporalCoverage: '2026-08-21/..',
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${origin}/api/v1/index.json` },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${origin}/api/v1/ircc-forward-looking.json` },
    ],
    isBasedOn: Object.values(stats.per_source).map(s => s.name),
  },
];

// A few interesting live examples for the hero
const examples = ['ca-visitor-visa--in', 'ca-study-permit--pk', 'ca-work-permit--mx', 'ca-visitor-visa--ng']
  .map(id => records.find(r => r.id === id)).filter(Boolean).filter(r => r.status === 'ok');
const govCount = stats.jurisdictions.length;
---
<Base title={`${config.SITE_NAME} — official visa and government processing times`}
      description={`Current official processing times for ${stats.entities.toLocaleString()} visa, permit and sponsorship routes across ${govCount} governments. Every value is sourced, dated and tracked.`}
      jsonld={jsonld}>
  <h1>How long will it take?<br/>The current official answer, tracked.</h1>
  <p class="lede">Governments publish how long applications are taking, but their current pages often replace the earlier number. We record each verified value with its source and date, so you can see today’s official figure and, when it changes, the history the source page no longer shows.</p>

  <div class="related" style="margin-top:16px">
    {examples.map(r => (
      <a href={`/${r.jur.slug}/${r.serviceSlug}/${r.applicantSlug}/`}>
        {r.jur.name} {services[r.jurisdiction].get(r.serviceSlug).name.toLowerCase()} · {r.applicant_country_name}: <strong class="num">&nbsp;{r.value_raw}</strong>
      </a>
    ))}
  </div>

  <div class="stats">
    <div><div class="n">{stats.entities.toLocaleString()}</div><div class="l">routes tracked</div></div>
    <div><div class="n">{stats.observations.toLocaleString()}</div><div class="l">observations recorded</div></div>
    <div><div class="n">{stats.forward_looking_estimates.toLocaleString()}</div><div class="l">IRCC projection rows</div></div>
    <div><div class="n">{govCount}</div><div class="l">governments</div></div>
  </div>
  <AdSlot position="home-top" />

  <h2>Reports and practical planning guides</h2>
  <ul class="grid">
    <li><a class="t" href="/reports/">Processing-time change reports</a><p class="small muted">Permanent dated issues built from consecutive official observations, with unchanged and unavailable values kept separate.</p></li>
    <li><a class="t" href="/canada/canadian-experience-class/">Canada CEC projected wait and queue</a><p class="small muted">IRCC’s current new-application projection plus its application-month estimates, kept separate from backward-looking figures.</p></li>
    <li><a class="t" href="/guides/canada-study-permit-from-india/">Canada study permit from India</a><p class="small muted">Current official time, major-route comparisons and clean clock boundaries.</p></li>
    <li><a class="t" href="/guides/uk-spouse-visa-processing-time/">UK spouse and partner visas</a><p class="small muted">Outside, inside and private-life figures without blending different routes.</p></li>
    <li><a class="t" href="/guides/new-zealand-aewv-processing-time/">New Zealand AEWV timeline</a><p class="small muted">The visa’s 50% and 80% measures inside the employer-led sequence.</p></li>
    <li><a class="t" href="/guides/how-norway-udi-waiting-times-work/">Norway UDI waiting times</a><p class="small muted">Nineteen dated, table-backed routes with monthly source history and no personalised-form guessing.</p></li>
  </ul>

  {Object.entries(JURISDICTIONS).map(([code, jur]) => (
    <section>
      <h2><a href={`/${jur.slug}/`}>{jur.name}</a> <span class="muted small">— {jur.agency}</span></h2>
      <ul class="grid">
        {publishedServices(code).map(svc => (
          <li>
            <a class="t" href={`/${jur.slug}/${svc.slug}/`}>{svc.name}</a><br />
            <span class="small muted">{svc.hasApplicantPages
              ? `${svc.records.length} applicant countries`
              : svc.isPercentileService
                ? `50%: ${svc.percent50.value_raw} · 80%: ${svc.percent80.value_raw}`
                : svc.records[0].value_raw} · data date {fmtDate(svc.latestEffective)}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <h2>Why trust these numbers?</h2>
  <p class="lede small">Because they aren't ours. Every figure is the government's own published statistic — we just refuse to let it disappear. Each value links its official source, carries the agency's update date when supplied (or a clearly labeled first-observed date when not), includes our verification date, and joins a permanent history. Read the <a href="/about/">methodology</a>, <a href="/about/editorial-policy/">editorial policy</a> and <a href="/about/research-desk/">Research Desk byline</a>.</p>

  <h2>For machines</h2>
  <p class="small">The same dataset is a <a href="/api-docs/">free JSON API</a>, a <a href="https://github.com/artwisdom/govwait/tree/main/machine/mcp-server" rel="noopener">public MCP server for AI agents</a>, and is described in <a href="/llms.txt">llms.txt</a>. Attribution required (CC BY 4.0).</p>
  <AdSlot position="home-bottom" />
</Base>
